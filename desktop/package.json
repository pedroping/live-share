{
  "name": "live-share-desktop",
  "productName": "Live Share",
  "version": "1.0.2",
  "private": true,
  "description": "Desktop broadcaster for live-share: Discord-style screen picker and per-app audio (exclude Discord)",
  "main": "main.js",
  "scripts": {
    "build:native": "node scripts/build-native.js",
    "sync": "node scripts/sync-shared.js",
    "prestart": "npm run sync && npm run build:native",
    "start": "electron .",
    "predist": "npm run sync && npm run build:native",
    "dist": "electron-builder --win portable nsis",
    "test:e2e": "npm run sync && npm run build:native && electron test/e2e.js",
    "test": "npm run build:native && node --test test/appaudio.test.js"
  },
  "build": {
    "appId": "com.pedroping.liveshare",
    "productName": "Live Share",
    "files": [
      "main.js",
      "audio-capture.js",
      "preload.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "native/appaudio.exe",
        "to": "appaudio.exe"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "allowScripts": {
    "electron@33.2.1": true
  }
}
